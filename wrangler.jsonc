{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tocaregalo-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://localhost:8787",
    "SESSION_TTL_SECONDS": "86400",
    "EMAIL_VERIFICATION_TTL_SECONDS": "86400",
    "PASSWORD_RECOVERY_TTL_SECONDS": "1800",
    "LOCAL_COUNTRY_PHONE_PREFIX": "+34",
    "APP_ENV": "development",
    "RESEND_TEST_MODE": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tocaregalo-local",
      // Local-only placeholder. Replace with a real D1 ID before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
