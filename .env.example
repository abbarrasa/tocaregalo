# Review-only values for static Compose validation, not runtime credentials.
# Copy to an ignored local file and replace secrets only when setup is authorized.
COMPOSE_PROJECT_NAME=tocaregalo
APP_ENV=dev
APP_TIMEZONE=Europe/Madrid
APP_SECRET=REVIEW_ONLY_REPLACE_BEFORE_RUNTIME
APP_PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
MAILPIT_PORT=8025
LOCAL_UID=1000
LOCAL_GID=1000

# Approved image families; exact patch versions and digests are resolved in 002:T2.
PHP_BASE_IMAGE=php:8.5-fpm-bookworm
COMPOSER_IMAGE=composer:2
NODE_BASE_IMAGE=node:24-bookworm-slim
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:stable-alpine
MAILPIT_IMAGE=axllent/mailpit:v1
PHP_LOCAL_IMAGE=tocaregalo-php:dev
NODE_LOCAL_IMAGE=tocaregalo-node:dev

MYSQL_DATABASE=tocaregalo
MYSQL_USER=tocaregalo
MYSQL_PASSWORD=REVIEW_ONLY_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REVIEW_ONLY_ROOT_PASSWORD
DATABASE_URL="mysql://tocaregalo:REVIEW_ONLY_DB_PASSWORD@mysql:3306/tocaregalo?serverVersion=8.4.0&charset=utf8mb4"

# Mailpit captures local messages only; no forwarding or real SMTP credentials.
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=no-reply@tocaregalo.test
MAIL_FROM_NAME="Toca Regalo"
PASSWORD_RESET_TTL_SECONDS=3600
NOTIFICATION_RETRY_BASE_MS=30000
MESSENGER_TRANSPORT_DSN="doctrine://default?queue_name=notifications&auto_setup=false"

# Keys do not exist yet and are never generated by container startup.
ASSIGNMENT_KEY_PATH=./.secrets/assignment-keys.json
ASSIGNMENT_KEY_FILE=/run/secrets/assignment_keys

# Test override uses a separate Compose project and therefore separate volumes.
TEST_HTTP_PORT=8081
TEST_MAILPIT_PORT=8026
TEST_MYSQL_DATABASE=tocaregalo_test
TEST_DATABASE_URL="mysql://tocaregalo:REVIEW_ONLY_DB_PASSWORD@mysql:3306/tocaregalo_test?serverVersion=8.4.0&charset=utf8mb4"
TEST_ASSIGNMENT_KEY_PATH=./.secrets/test-assignment-keys.json
