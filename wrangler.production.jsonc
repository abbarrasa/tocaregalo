{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tocaregalo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/frontend",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://tocaregalo.es",
    "SESSION_TTL_SECONDS": "86400",
    "EMAIL_VERIFICATION_TTL_SECONDS": "86400",
    "PASSWORD_RECOVERY_TTL_SECONDS": "1800",
    "LOCAL_COUNTRY_PHONE_PREFIX": "+34",
    "APP_ENV": "production",
    "RESEND_TEST_MODE": "false",
    "RESEND_FROM_EMAIL": "no-reply@tocaregalo.es",
    "GOOGLE_CLIENT_ID": "39430340862-iokegjpo291chd3seqm4gpb846odvhj1.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://tocaregalo.es/api/auth/google/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tocaregalo-prod",
      "database_id": "26a3836b-c633-4ac1-ae5a-85a95701d284",
      "migrations_dir": "migrations"
    }
  ]
}