{
   "autoload" : {
      "psr-4" : {
         "App\\" : "src/"
      }
   },
   "autoload-dev" : {
      "psr-4" : {
         "App\\Tests\\" : "tests/"
      }
   },
   "config" : {
      "allow-plugins" : {
         "symfony/runtime" : true
      },
      "sort-packages" : true
   },
   "conflict" : {
      "api-platform/doctrine-common" : "<4.2 || >=4.3",
      "api-platform/documentation" : "<4.2 || >=4.3",
      "api-platform/http-cache" : "<4.2 || >=4.3",
      "api-platform/hydra" : "<4.2 || >=4.3",
      "api-platform/json-schema" : "<4.2 || >=4.3",
      "api-platform/jsonld" : "<4.2 || >=4.3",
      "api-platform/metadata" : "<4.2 || >=4.3",
      "api-platform/openapi" : "<4.2 || >=4.3",
      "api-platform/serializer" : "<4.2 || >=4.3",
      "api-platform/state" : "<4.2 || >=4.3",
      "api-platform/validator" : "<4.2 || >=4.3",
      "symfony/asset" : "<7.4 || >=7.5",
      "symfony/cache" : "<7.4 || >=7.5",
      "symfony/config" : "<7.4 || >=7.5",
      "symfony/dependency-injection" : "<7.4 || >=7.5",
      "symfony/doctrine-bridge" : "<7.4 || >=7.5",
      "symfony/dom-crawler" : "<7.4 || >=7.5",
      "symfony/error-handler" : "<7.4 || >=7.5",
      "symfony/event-dispatcher" : "<7.4 || >=7.5",
      "symfony/filesystem" : "<7.4 || >=7.5",
      "symfony/finder" : "<7.4 || >=7.5",
      "symfony/http-foundation" : "<7.4 || >=7.5",
      "symfony/http-kernel" : "<7.4 || >=7.5",
      "symfony/mime" : "<7.4 || >=7.5",
      "symfony/property-access" : "<7.4 || >=7.5",
      "symfony/property-info" : "<7.4 || >=7.5",
      "symfony/routing" : "<7.4 || >=7.5",
      "symfony/security-core" : "<7.4 || >=7.5",
      "symfony/security-http" : "<7.4 || >=7.5",
      "symfony/stopwatch" : "<7.4 || >=7.5",
      "symfony/string" : "<7.4 || >=7.5",
      "symfony/twig-bridge" : "*",
      "symfony/twig-bundle" : "*",
      "symfony/type-info" : "<7.4 || >=7.5",
      "symfony/uid" : "<7.4 || >=7.5",
      "symfony/var-dumper" : "<7.4 || >=7.5",
      "symfony/var-exporter" : "<7.4 || >=7.5",
      "symfony/web-link" : "<7.4 || >=7.5",
      "twig/twig" : "*"
   },
   "description" : "Toca Regalo JSON API",
   "minimum-stability" : "stable",
   "name" : "tocaregalo/backend",
   "prefer-stable" : true,
   "require" : {
      "api-platform/doctrine-orm" : "~4.2.0",
      "api-platform/symfony" : "~4.2.0",
      "doctrine/dbal" : "^4.0",
      "doctrine/doctrine-bundle" : "^3.0",
      "doctrine/doctrine-migrations-bundle" : "^3.0",
      "doctrine/orm" : "^3.0",
      "ext-ctype" : "*",
      "ext-iconv" : "*",
      "ext-intl" : "*",
      "ext-mbstring" : "*",
      "ext-pdo_mysql" : "*",
      "ext-sodium" : "*",
      "php" : "~8.5.0",
      "symfony/clock" : "7.4.*",
      "symfony/console" : "7.4.*",
      "symfony/doctrine-messenger" : "7.4.*",
      "symfony/dotenv" : "7.4.*",
      "symfony/framework-bundle" : "7.4.*",
      "symfony/mailer" : "7.4.*",
      "symfony/messenger" : "7.4.*",
      "symfony/password-hasher" : "7.4.*",
      "symfony/runtime" : "7.4.*",
      "symfony/security-bundle" : "7.4.*",
      "symfony/security-csrf" : "7.4.*",
      "symfony/serializer" : "7.4.*",
      "symfony/validator" : "7.4.*",
      "symfony/yaml" : "7.4.*"
   },
   "require-dev" : {
      "phpunit/phpunit" : "^12.0",
      "symfony/browser-kit" : "7.4.*",
      "symfony/css-selector" : "7.4.*"
   },
   "type" : "project"
}
