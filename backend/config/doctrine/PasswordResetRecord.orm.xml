<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Infrastructure\Doctrine\Record\PasswordResetRecord" table="password_reset_requests">
        <unique-constraints><unique-constraint name="UNIQ_RESET_TOKEN" columns="token_hash"/></unique-constraints>
        <indexes><index name="IDX_RESET_USER" columns="user_id"/></indexes>
        <id name="id" type="integer"><generator strategy="IDENTITY"/></id>
        <many-to-one field="user" target-entity="App\Infrastructure\Doctrine\Record\UserRecord">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="issuedAt" column="issued_at" type="datetime_immutable" column-definition="DATETIME(6) NOT NULL"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable" column-definition="DATETIME(6) NOT NULL"/>
        <field name="consumedAt" column="consumed_at" type="datetime_immutable" nullable="true" column-definition="DATETIME(6) DEFAULT NULL"/>
        <field name="supersededAt" column="superseded_at" type="datetime_immutable" nullable="true" column-definition="DATETIME(6) DEFAULT NULL"/>
    </entity>
</doctrine-mapping>
