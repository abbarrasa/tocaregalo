<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Infrastructure\Doctrine\Record\UserRecord" table="users">
        <id name="id" type="integer"><generator strategy="IDENTITY"/></id>
        <field name="firstName" column="first_name" type="string"/>
        <field name="lastName" column="last_name" type="string" nullable="true"/>
        <field name="email" type="string"/>
        <field name="emailComparison" column="email_comparison" type="string" unique="true">
            <options><option name="collation">utf8mb4_bin</option></options>
        </field>
        <field name="phone" type="string" unique="true"/>
        <field name="passwordHash" column="password_hash" type="string"/>
        <many-to-many field="roles" target-entity="App\Infrastructure\Doctrine\Record\RoleRecord">
            <join-table name="user_roles">
                <join-columns><join-column name="user_id" referenced-column-name="id" on-delete="CASCADE"/></join-columns>
                <inverse-join-columns><join-column name="role_id" referenced-column-name="id" on-delete="CASCADE"/></inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>
</doctrine-mapping>
